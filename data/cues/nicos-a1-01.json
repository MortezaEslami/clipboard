{"cues":[{"s":0.12,"e":12.72,"de":"Guten Morgen, Herr Müller, wie geht es Ihnen?","en":"Good morning, Mr. Müller, how are you?","fa":"صبح بخیر آقای مولر، حال شما چطور است؟"},{"s":13.26,"e":14.7,"de":"Guten Morgen, Frau Schneider.","en":"Good morning, Mrs. Schneider.","fa":"صبح بخیر خانم اشنایدر."},{"s":14.98,"e":15.9,"de":"Danke, gut!","en":"Thanks, I'm well!","fa":"ممنون، خوبم!"},{"s":16.18,"e":17.04,"de":"Und Ihnen?","en":"How about you?","fa":"و شما؟"},{"s":18.04,"e":20.08,"de":"Guten Morgen, Herr Müller, wie geht es Ihnen?","en":"Good morning, Mr. Müller, how are you?","fa":"صبح بخیر آقای مولر، حال شما چطور است؟"},{"s":20.6,"e":22.06,"de":"Guten Morgen, Frau Schneider.","en":"Good morning, Mrs. Schneider.","fa":"صبح بخیر خانم اشنایدر."},{"s":22.36,"e":23.24,"de":"Danke, gut!","en":"Thanks, I'm well!","fa":"ممنون، خوبم!"},{"s":23.48,"e":24.42,"de":"Und Ihnen?","en":"How about you?","fa":"و شما؟"},{"s":26.59,"e":27.77,"de":"Guten Tag, Frau Kamp.","en":"Hello, Mrs. Kamp.","fa":"روز بخیر خانم کامپ."},{"s":27.89,"e":28.57,"de":"Guten Tag!","en":"Hello!","fa":"روز بخیر!"},{"s":28.89,"e":29.67,"de":"Wie geht es Ihnen?","en":"How are you?","fa":"حال شما چطور است؟"},{"s":29.89,"e":31.17,"de":"Sehr gut, danke.","en":"Very good, thank you.","fa":"خیلی خوب، ممنون."},{"s":31.45,"e":32.2,"de":"Und Ihnen?","en":"How about you?","fa":"و شما؟"},{"s":34.31,"e":35.07,"de":"Hey, Lena!","en":"Hey, Lena!","fa":"سلام لنا!"},{"s":35.43,"e":36.63,"de":"Na, wie geht's?","en":"How's it going?","fa":"خب، چطوری؟"},{"s":36.77,"e":37.41,"de":"Hallo, Opa!","en":"Hello, Grandpa!","fa":"سلام پدربزرگ!"},{"s":37.43,"e":40.3,"de":"Hallo, Sarah.","en":"Hello, Sarah.","fa":"سلام سارا."},{"s":40.66,"e":41.36,"de":"Wie geht's dir?","en":"How are you?","fa":"حالت چطور است؟"},{"s":41.82,"e":42.46,"de":"Hi, Tom!","en":"Hi, Tom!","fa":"سلام تام!"},{"s":42.84,"e":43.58,"de":"Super, danke.","en":"Great, thank you.","fa":"عالی‌ام، ممنون."},{"s":44.12,"e":44.87,"de":"Und dir?","en":"How are you?","fa":"و تو؟"},{"s":50.84,"e":52.7,"de":"Die Tasche ist schön!","en":"The bag is beautiful!","fa":"این کیف قشنگ است!"},{"s":53.48,"e":54.06,"de":"Entschuldigung?","en":"Excuse me?","fa":"ببخشید؟"},{"s":54.92,"e":55.67,"de":"Schön?","en":"Nice?","fa":"قشنگ؟"},{"s":56.46,"e":57.62,"de":"Ja, die Tasche!","en":"Yes, the bag!","fa":"بله، همین کیف!"},{"s":63.26,"e":64.28,"de":"Emma, komm jetzt!","en":"Emma, come on!","fa":"اما، زود باش، بیا!"},{"s":64.68,"e":65.3,"de":"Entschuldigung!","en":"Excuse me!","fa":"ببخشید؟"},{"s":74.65,"e":76.09,"de":"Adalbert-Stifter-Straße …","en":"Adalbert-Stifter-Straße ...","fa":"خیابان آدالبرت اشتیفتر …"},{"s":122.76,"e":124.26,"de":"Ja, ich bin gut angekommen.","en":"Yes, I arrived safely.","fa":"بله، سالم رسیدم."},{"s":124.8,"e":127.2,"de":"Du kannst mir die Unterlagen für das Meeting im Hotel hinterlegen.","en":"You can leave me the papers for the meeting at the hotel.","fa":"می‌توانی مدارک جلسه را در هتل برایم بگذاری."},{"s":127.22,"e":143.96,"de":"Ins Zentrum bitte.","en":"To the center, please.","fa":"لطفاً به مرکز شهر."},{"s":144.04,"e":144.72,"de":"Zum Königshof.","en":"To Königshof.","fa":"به «کونیگزهوف»."},{"s":145.22,"e":146.98,"de":"Ins Zentrum, zum Königshof.","en":"To the center, to Königshof.","fa":"به مرکز شهر، به کونیگزهوف."},{"s":148.05,"e":150.41,"de":"Ins Restaurant Königshof oder zum Hotel Königshof?","en":"To the restaurant Königshof or to the hotel Königshof?","fa":"رستوران کونیگزهوف یا هتل کونیگزهوف؟"},{"s":150.99,"e":151.85,"de":"Hotel Königshof.","en":"Hotel Königshof.","fa":"هتل کونیگزهوف."},{"s":152.19,"e":152.97,"de":"Okay, kein Problem.","en":"Okay, no problem.","fa":"باشه، مشکلی نیست."},{"s":170.98,"e":171.78,"de":"Tschüss, Martina.","en":"Bye, Martina.","fa":"خداحافظ مارتینا."},{"s":171.96,"e":172.66,"de":"Gute Reise!","en":"Have a good trip!","fa":"سفر بخیر!"},{"s":173.44,"e":174.73,"de":"Mach's gut, Herbert.","en":"Take care, Herbert.","fa":"خدانگهدار هربرت."},{"s":174.82,"e":175.38,"de":"Bis bald!","en":"See you soon!","fa":"به زودی می‌بینمت!"},{"s":176.08,"e":176.83,"de":"Tschüss!","en":"Bye!","fa":"خداحافظ!"},{"s":181.01,"e":182.33,"de":"Auf Wiedersehen, Herr Tillmanns.","en":"Goodbye, Mr. Tillmanns.","fa":"خداحافظ آقای تیلمانس."},{"s":182.35,"e":183.01,"de":"Gute Reise!","en":"Have a good trip!","fa":"سفر بخیر!"},{"s":183.15,"e":183.83,"de":"Danke schön!","en":"Thank you.","fa":"خیلی ممنون!"},{"s":183.85,"e":184.79,"de":"Auf Wiedersehen, Frau Scholl.","en":"Goodbye, Mrs Scholl.","fa":"خداحافظ خانم شول."},{"s":195.97,"e":196.99,"de":"Alles okay?","en":"You okay?","fa":"همه‌چیز مرتب است؟"},{"s":199.58,"e":200.36,"de":"Brauchst du Hilfe?","en":"Do you need help?","fa":"کمک می‌خواهی؟"},{"s":203.32,"e":204.44,"de":"Hilfe, help?","en":"Help, help?","fa":"کمک، «help»؟"},{"s":204.88,"e":205.7,"de":"Do you need help?","en":"Do you need help?","fa":"کمک می‌خواهی؟"},{"s":206.68,"e":207.43,"de":"Ja!","en":"Yes!","fa":"بله!"},{"s":207.44,"e":207.89,"de":"Hilfe!","en":"Help!","fa":"کمک!"},{"s":207.68,"e":209.24,"de":"Wo ist die Tasche?","en":"Where's the bag?","fa":"کیف کجاست؟"},{"s":210.21,"e":210.91,"de":"Die Tasche ist …","en":"The bag is...","fa":"کیف …"},{"s":210.93,"e":212.43,"de":"gone …","en":"gone ...","fa":"رفته …"},{"s":212.56,"e":213.38,"de":"in the...","en":"in the...","fa":"توی …"},{"s":213.4,"e":214.18,"de":"Taxi!","en":"Taxi!","fa":"تاکسی!"},{"s":216.15,"e":217.51,"de":"Die Tasche ist weg in dem Taxi?","en":"The bag's gone in the cab?","fa":"کیف توی تاکسی جا مانده؟"},{"s":222.36,"e":223.12,"de":"Wohin willst du?","en":"Where are you going?","fa":"کجا می‌خواهی بروی؟"},{"s":225.17,"e":225.89,"de":"Wohin?","en":"Where?","fa":"کجا؟"},{"s":226.45,"e":227.85,"de":"Willst du ins Zentrum?","en":"Do you want to go to the center?","fa":"می‌خواهی بروی مرکز شهر؟"},{"s":228.27,"e":228.99,"de":"Zentrum, ja!","en":"Center, yes!","fa":"مرکز شهر، بله!"},{"s":235.67,"e":236.42,"de":"Yara.","en":"Yara.","fa":"یارا."},{"s":238.02,"e":238.92,"de":"Wer ist Yara?","en":"Who's Yara?","fa":"یارا کیست؟"},{"s":240.86,"e":241.58,"de":"Meine...","en":"My...","fa":"من ..."},{"s":242.32,"e":243.04,"de":"aunt?","en":"Aunt?","fa":"عمه؟"},{"s":243.64,"e":244.4,"de":"Deine Tante?","en":"Your aunt?","fa":"عمه‌ات؟"},{"s":244.8,"e":245.55,"de":"Nicht schlecht!","en":"Not bad!","fa":"بد نیست!"},{"s":247.19,"e":248.41,"de":"Du willst zu deiner Tante?","en":"You want to see your aunt?","fa":"می‌خواهی پیش عمه‌ات بروی؟"},{"s":248.43,"e":249.13,"de":"Zu Yara?","en":"Yara?","fa":"پیش یارا؟"},{"s":249.79,"e":250.49,"de":"Hast du die Adresse?","en":"Do you have the address?","fa":"آدرس را داری؟"},{"s":250.51,"e":254.12,"de":"Adresse: Straße, Hausnummer?","en":"Address: Street, number?","fa":"آدرس: خیابان، شماره خانه؟"},{"s":254.38,"e":255.0,"de":"Andel …","en":"Andel...","fa":"اندل …"},{"s":257.09,"e":258.41,"de":"Adelschiffstraße?","en":"Adelschiffstraße?","fa":"خیابان آدلشیف؟"},{"s":259.11,"e":259.85,"de":"Die kenn ich nicht …","en":"I don't know her...","fa":"آن را نمی‌شناسم …"},{"s":266.66,"e":268.08,"de":"Komm, wir helfen dir!","en":"Come on, let's help you!","fa":"بیا، کمکت می‌کنیم!"},{"s":268.52,"e":283.42,"de":"Mein Name ist Emma!","en":"My name is Emma!","fa":"اسم من اما است!"},{"s":284.12,"e":285.3,"de":"Und das ist meine Tante.","en":"And this is my aunt.","fa":"و این عمه‌ام است."},{"s":285.7,"e":286.4,"de":"Deine Mama?","en":"Your mama?","fa":"مادرت؟"},{"s":287.04,"e":288.8,"de":"Nein, Lisa ist nicht meine Mama.","en":"No, Lisa's not my mom.","fa":"نه، لیزا مادرم نیست."},{"s":288.98,"e":290.12,"de":"Sie ist meine Tante.","en":"She's my aunt.","fa":"او عمه‌ام است."},{"s":290.78,"e":291.34,"de":"Meine Mama …","en":"My mama...","fa":"مادرم …"},{"s":291.36,"e":295.0,"de":"fliegt nach Amerika.","en":"I'm going to America.","fa":"به آمریکا پرواز می‌کند."},{"s":295.24,"e":296.12,"de":"Sie arbeitet da.","en":"She works there.","fa":"او آنجا کار می‌کند."},{"s":297.81,"e":298.56,"de":"Bitte!","en":"Please!","fa":"بفرما!"}]}