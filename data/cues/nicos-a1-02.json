,{"s":187.27,"e":187.72,"de":"Und deine Familie?","en":"And your family?","fa":"و خانواده‌ات؟"},{"s":187.66,"e":189.28,"de":"Kannst du deine Familie anrufen?","en":"Can you call your family?","fa":"می‌توانی به خانواده‌ات زنگ بزنی؟"},{"s":189.46,"e":190.21,"de":"Nein.","en":"Nope.","fa":"نه."},{"s":190.77,"e":192.11,"de":"Kann dein Vater nicht helfen?","en":"Can't your father help?","fa":"پدرت نمی‌تواند کمک کند؟"},{"s":192.31,"e":193.11,"de":"Er ist doch bei der Polizei.","en":"He's with the police.","fa":"او که در پلیس کار می‌کند."},{"s":194.36,"e":194.96,"de":"Gute Idee!","en":"Good idea!","fa":"فکر خوبی است!"},{"s":195.36,"e":196.11,"de":"Vater?","en":"Father?","fa":"پدر؟"},{"s":196.3,"e":197.86,"de":"Mein Vater ist Polizist.","en":"My father's a cop.","fa":"پدرم پلیس است."},{"s":198.36,"e":199.11,"de":"Police.","en":"Police.","fa":"پلیس."},{"s":199.22,"e":200.25,"de":"Vielleicht hilft er uns.","en":"Maybe he'll help us.","fa":"شاید به ما کمک کند."},{"s":200.27,"e":201.02,"de":"Moment!","en":"Wait!","fa":"یک لحظه!"},{"s":211.01,"e":211.71,"de":"Polizeirevier Ost, Brunner hier.","en":"Police station east, Brunner here.","fa":"کلانتری شرق، برونر پای تلفن."},{"s":211.73,"e":212.91,"de":"Ah, hallo, Lisa.","en":"Hello, Lisa.","fa":"آه، سلام لیزا."},{"s":213.17,"e":213.75,"de":"Wie geht's dir?","en":"How are you?","fa":"حالت چطور است؟"},{"s":213.99,"e":215.33,"de":"Was ist los?","en":"What's going on?","fa":"چه شده؟"},{"s":215.33,"e":216.61,"de":"Geht es Emma nicht gut?","en":"Is Emma not well?","fa":"اما حالش خوب نیست؟"},{"s":216.87,"e":217.97,"de":"Doch, keine Sorge!","en":"Yes, don't worry!","fa":"چرا، نگران نباش!"},{"s":218.05,"e":218.83,"de":"Emma geht es gut.","en":"Emma's fine.","fa":"اما حالش خوب است."},{"s":218.89,"e":220.67,"de":"Aber Nico hat ein Problem.","en":"But Nico has a problem.","fa":"ولی نیکو یک مشکل دارد."},{"s":221.07,"e":222.23,"de":"Er war auch am Flughafen.","en":"He was at the airport, too.","fa":"او هم در فرودگاه بود."},{"s":222.25,"e":223.29,"de":"Er kommt aus Spanien.","en":"He's from Spain.","fa":"او اهل اسپانیا است."},{"s":223.94,"e":225.45,"de":"Ja, genau.","en":"Yeah, that's right.","fa":"بله، درست است."},{"s":226.13,"e":229.09,"de":"Er kommt aus Spanien und er hat ein Problem.","en":"He's from Spain, and he's got a problem.","fa":"او اهل اسپانیا است و یک مشکل دارد."},{"s":229.93,"e":232.15,"de":"Seine Tasche ist weg und er spricht nicht gut Deutsch.","en":"His bag is gone and he doesn't speak German well.","fa":"کیفش گم شده و آلمانی‌اش خوب نیست."},{"s":232.51,"e":233.27,"de":"Hat er Papiere?","en":"Does he have papers?","fa":"مدرک دارد؟"},{"s":233.85,"e":235.31,"de":"Einen Ausweis oder einen Pass?","en":"I.D. or passport?","fa":"کارت شناسایی یا پاسپورت؟"},{"s":235.85,"e":236.61,"de":"Hast du einen Pass?","en":"Do you have a passport?","fa":"پاسپورت داری؟"},{"s":237.83,"e":238.39,"de":"Passport?","en":"Passport?","fa":"پاسپورت؟"},{"s":239.76,"e":240.38,"de":"Nein.","en":"Nope.","fa":"نه."},{"s":240.98,"e":243.02,"de":"Nicos Pass ist in seiner Tasche.","en":"Nico's passport is in his pocket.","fa":"پاسپورت نیکو توی کیفش است."},{"s":244.29,"e":246.07,"de":"Aber er hat ein Foto von seiner Tante.","en":"But he's got a picture of his aunt.","fa":"ولی یک عکس از عمه‌اش دارد."},{"s":246.27,"e":248.95,"de":"Sie wohnt auch hier in Deutschland, aber Nico hat die Adresse nicht.","en":"She also lives here in Germany, but Nico doesn't have the address.","fa":"او هم اینجا در آلمان زندگی می‌کند، ولی نیکو آدرس را ندارد."},{"s":249.83,"e":250.5,"de":"Meine Tante …","en":"My aunt...","fa":"عمه‌ی من …"},{"s":250.52,"e":252.25,"de":"She has a bicycle shop.","en":"She has a bicycle shop.","fa":"او یک دوچرخه‌فروشی دارد."},{"s":253.19,"e":256.11,"de":"Seine Tante hat ein Geschäft, ein Fahrradgeschäft.","en":"His aunt has a shop, a bicycle store.","fa":"عمه‌ی او یک مغازه دارد، یک دوچرخه‌فروشی."},{"s":256.13,"e":258.41,"de":"Wir suchen also eine Adresse.","en":"So we're looking for an address.","fa":"پس ما دنبال یک آدرس هست